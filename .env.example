# Copy to .env and fill in. Never commit real secrets.

# Neon Postgres (pooled connection string)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# NextAuth (Auth.js) — generate with: openssl rand -base64 32
AUTH_SECRET=""

# Google OAuth credentials
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Vercel Blob — listing photo uploads. Create a Blob store in the Vercel
# dashboard (Storage → Blob) or run `vercel blob store add`, then copy the token.
BLOB_READ_WRITE_TOKEN=""

# Resend email (optional in dev — codes log to console if blank)
RESEND_API_KEY=""
EMAIL_FROM="UIUC Sublease <onboarding@resend.dev>"

# Report notification recipient
ADMIN_EMAIL=""

# Allowed signup/login email domain
ALLOWED_EMAIL_DOMAIN="illinois.edu"

# Protects the scheduled cleanup endpoint
CRON_SECRET=""
